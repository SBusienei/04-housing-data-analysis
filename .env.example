# Copy to .env and use the credentials from your local DBeaver connection.
# Do not commit .env or put real credentials in this example.
PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel_bookings
PGUSER=postgres
PGPASSWORD=replace_with_your_local_password
# Suitable for local learning. Use verify-full and a trusted CA for remote use.
PGSSLMODE=prefer

